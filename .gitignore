# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing / coverage
/coverage

# Production builds
/build
dist/

# Environment files — never commit real secrets
.env
.env.*
*.env
*credentials.json*
*token.json*
*.key
*.pem

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv*/
venv*/

# Build caches
.cache/

# Agent/build scaffolding — not project source, safe to keep locally only
memory/
test_reports/
test_result.md
.gitconfig

# Archive files that shouldn't be versioned
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz